{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woohop-warmup",
  "compatibility_date": "2025-11-01",

  /*
   * 所有暖場遊戲（games/*）合在一個**只有靜態資源的 Worker，沒有 `main`**：
   * 這些遊戲都沒有房間、沒有後端，手機只在主持人手上。
   * `dist` 是 scripts/build.js 產生的（dist/bomb/、dist/bamboo/⋯），不進版控。
   */
  "assets": {
    "directory": "./dist",
    // /bamboo/ → dist/bamboo/index.html（語言轉址頁）、/bamboo/zh-TW/ → dist/bamboo/zh-TW/index.html
    "html_handling": "auto-trailing-slash",
    // 找不到回真 404，不回 index.html（ARCHITECTURE.md 3.1：整個網域只有首頁那張 404）
    "not_found_handling": "none"
  },

  "observability": { "enabled": true }
}
