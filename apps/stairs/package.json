{
  "name": "web100-stairs",
  "version": "0.1.0",
  "private": true,
  "description": "Woohop：上樓下樓，不用手機的破冰團康，手機只負責帶領、節拍器與真心話大冒險拉霸（Cloudflare Workers 靜態資源）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && wrangler dev",
    "dev:lan": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
