{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woohop-feedback",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",

  /*
   * 「聯絡我們」頁的意見表單（/{lang}/contact/）送到這裡，整理成一封信寄到 woohop.app@gmail.com。
   * 首頁的 vercel.json 把 /api/feedback 代理過來，瀏覽器看到的是同一個網域。
   *
   * 寄信用 Email Routing 的 send_email（只能寄給已驗證的收件地址，不用 API 金鑰）。
   * 寄件人要用有開 Email Routing 的網域：vibeweb100.com。
   */
  "send_email": [{ "name": "MAIL", "destination_address": "woohop.app@gmail.com" }],

  // 同一個來源每分鐘最多 5 封，擋手滑連按與簡單的灌信
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],

  "observability": { "enabled": true }
}
