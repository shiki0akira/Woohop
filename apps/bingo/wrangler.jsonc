{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web100-04-happy-bingo",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",

  // 跟搶答、喜好二選一一樣：靜態頁跟 API 走同一個 Worker，WebSocket 與網頁同源、
  // 不用處理 CORS，也只有一個部署目標。`dist` 是 scripts/build.js 產生的，不進版控。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 找不到對應檔案時交給 Worker（例如 /bingo/ 要依語言轉址、/bingo/api/* 是 API）
    "not_found_handling": "none",
    "run_worker_first": ["/bingo/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "BingoRoom" }]
  },

  // SQLite backend 是新專案的預設，也是 Durable Object 免費方案唯一支援的儲存層
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BingoRoom"] }],

  // 房間型每個 WebSocket 訊息都算一筆紀錄，全收會吃光每天 20 萬筆的免費額度（2026-10-29）：只隨機收 10%
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
