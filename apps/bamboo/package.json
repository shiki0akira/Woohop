{
  "name": "web100-06-bamboo",
  "version": "0.1.0",
  "private": true,
  "description": "Woohop：竹筍竹筍蹦蹦出，不用手機的破冰遊戲，手機只負責取名、教學、配樂與分享轉盤（Cloudflare Workers 靜態資源）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && wrangler dev",
    "dev:lan": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
