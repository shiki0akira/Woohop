{
  "version": 2,
  "buildCommand": "node scripts/prerender.js",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vibeweb100.com"
        }
      ],
      "destination": "https://www.vibeweb100.com/$1",
      "permanent": true
    },
    {
      "source": "/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)/avalon/:path*",
      "destination": "/avalon/en",
      "permanent": true
    },
    {
      "source": "/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)/:page(game|rules)",
      "destination": "/avalon/en/:page",
      "permanent": true
    },
    {
      "source": "/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)/:path*",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/avalon/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)",
      "destination": "/avalon/en",
      "permanent": true
    },
    {
      "source": "/avalon/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)/",
      "destination": "/avalon/en",
      "permanent": true
    },
    {
      "source": "/avalon/:lang(cs|id|it|nl|pl|pt|ru|sv|th|vi)/:path*",
      "destination": "/avalon/en",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(zh-TW|en|de|fr|ja|ko|es|zh-CN)/index.html",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/zh-TW/",
      "permanent": false
    },
    {
      "source": "/:lang(zh-TW|en|de|fr|ja|ko|es|zh-CN)/avalon",
      "destination": "/avalon/:lang",
      "permanent": true
    },
    {
      "source": "/:lang(zh-TW|en|de|fr|ja|ko|es|zh-CN)/avalon/",
      "destination": "/avalon/:lang",
      "permanent": true
