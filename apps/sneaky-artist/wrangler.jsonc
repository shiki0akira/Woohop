{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woohop-sneaky-artist",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",

  // 跟搶答同一個做法：靜態頁跟 API 走同一個 Worker，`dist` 是 scripts/build.js 產生的，不進版控
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 找不到對應檔案時交給 Worker（/sneaky-artist/ 要依語言轉址、/sneaky-artist/api/* 是 API）
    "not_found_handling": "none",
    "run_worker_first": ["/sneaky-artist/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "SneakyRoom" }]
  },

  // SQLite backend 是 Durable Object 免費方案唯一支援的儲存層
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SneakyRoom"] }],

  // 畫畫時每一筆都是一個 WebSocket 訊息，全收會吃光每天的免費額度：只隨機收 5%
  "observability": { "enabled": true, "head_sampling_rate": 0.05 }
}
